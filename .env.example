# --- Access control (Admin / Dashboard) ---
# Comma-separated allowlist. In addition to holding the "owner" role in
# their Clerk publicMetadata (set from the Clerk Dashboard), a user's email
# must be in this list to access /admin and /dashboard.
OWNER_ALLOWED_EMAILS="ayman.benkardoud@gmail.com"
# How long (seconds) the locally cached Clerk role is trusted before being
# re-fetched from the Clerk API on the next protected-route request.
CLERK_ROLE_CACHE_TTL=300

# --- Optional external scan services (used by /api/stats/services) ---
# Leave empty to have the health-check report "not_configured" instead of
# a fake "online" status.
VIRUSTOTAL_API_KEY=""
GOOGLE_SAFE_BROWSING_API_KEY=""
